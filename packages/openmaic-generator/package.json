{
  "name": "@faithleysath/openmaic-generator",
  "version": "0.2.0",
  "description": "Node.js BYOK generation core for OpenMAIC classrooms",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./providers": {
      "types": "./dist/contracts/providers.d.ts",
      "import": "./dist/contracts/providers.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "openmaic.env.example"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "copy:prompts": "node scripts/copy-prompts.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json && pnpm run copy:prompts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:dry": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/faithleysath/OpenMAIC-CLI",
    "directory": "packages/openmaic-generator"
  },
  "openmaicUpstreamBaseline": "v0.3.1",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/azure": "^3.0.88",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.84",
    "@alicloud/docmind-api20220711": "^1.4.15",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@openmaic/dsl": "workspace:^0.4.0",
    "ai": "^6.0.168",
    "jszip": "^3.10.1",
    "jsonrepair": "^3.13.2",
    "katex": "^0.16.33",
    "nanoid": "^5.1.6",
    "partial-json": "^0.1.7",
    "sharp": "^0.34.5",
    "undici": "^7.22.0",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}

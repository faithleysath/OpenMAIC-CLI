{
  "name": "@faithleysath/openmaic-cli",
  "version": "0.1.0",
  "description": "Local BYOK command-line generator for OpenMAIC classrooms",
  "type": "module",
  "bin": {
    "openmaic": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:dry": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/faithleysath/OpenMAIC-CLI",
    "directory": "packages/openmaic-cli"
  },
  "license": "MIT",
  "dependencies": {
    "@faithleysath/openmaic-generator": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
